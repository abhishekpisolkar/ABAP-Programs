*&---------------------------------------------------------------------*
*& Report ZMM_PO_UPDATE
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
report zmm_po_update.
types : begin of ty_final_ser_cond,
          ebeln type ekpo-ebeln,
          ebelp type ekpo-ebelp,
          kschl type konv-kschl,
          kbetr type konv-kbetr,
        end of ty_final_ser_cond,
        begin of ty_final_txt,
          ebeln    type stxl-tdname,
          tdobject type stxl-tdobject,
          tdid     type stxl-tdid,
          text     type string,
        end of ty_final_txt,
        begin of ty_return,
          ebeln type ekko-ebeln,
          ebelp type ekpo-ebelp,
          unsez type ekko-unsez.
          include structure bapiret2.
types :  end of ty_return.

types : begin of ty_final_change,
          ebeln       type ekko-ebeln,
          ebelp       type ekpo-ebelp,
*          zekkn       type ekkn-zekkn,
          kostl       type ekkn-kostl,
          gl_account  type  saknr,
          wbs_element type  ps_posid,
          network     type  nplnr,
        end of ty_final_change.

data : it_final_ser_cond type table of ty_final_ser_cond,
       wa_final_ser_cond type ty_final_ser_cond,
       it_final_text     type table of ty_final_txt,
       wa_final_text     type ty_final_txt,
       it_return         type table of ty_return,
       it_final_change   type table of ty_final_change,
       wa_final_change   type ty_final_change.

selection-screen : begin of block b1 with frame title text-001.
  parameters : p_file   type rlgrap-filename obligatory,
               p_test   as checkbox default 'X',
               cond     radiobutton group rg1 user-command cmd,
               text     radiobutton group rg1,
               p_change radiobutton group rg1.
selection-screen : end of block b1.


at selection-screen on value-request for p_file.

  data : lv_rc       type i,
         lt_file_tab type filetable.

  call method cl_gui_frontend_services=>file_open_dialog
    exporting
      window_title = 'Select a file'
    changing
      file_table   = lt_file_tab
      rc           = lv_rc.
  if sy-subrc is initial.
    data(ls_file_tab) = value #( lt_file_tab[ 1 ] optional ).
    if ls_file_tab is not initial.
      p_file = ls_file_tab-filename.
    endif.
  endif.

start-of-selection.
  if cond is not initial.
    perform cond_uploadfile.
    perform cond_processdata.
  elseif text is not initial.
    perform text_uploadfile.
    perform text_processdata.
  elseif p_change is not initial.
    perform upload_file.
    perform change_po.
  endif.
  if it_return is not initial.
    try.
        cl_salv_table=>factory( importing r_salv_table = data(lo_tab)
                                changing  t_table      = it_return ).
        lo_tab->get_functions( )->set_all( ).
        lo_tab->get_columns( )->set_optimize( ).
        lo_tab->get_display_settings( )->set_striped_pattern( abap_true ).

        data:
          ls_key    type salv_s_layout_key,
          lo_layout type ref to cl_salv_layout.
        ls_key-report = sy-repid.
        lo_layout = lo_tab->get_layout( ).
        lo_layout->set_save_restriction( if_salv_c_layout=>restrict_none ).
        lo_layout->set_key( ls_key ).

        lo_tab->display( ).

      catch cx_root.
        message 'Error in ALV creation' type 'E'.
    endtry.
  endif.
*&---------------------------------------------------------------------*
*& Form uploadfile
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form cond_uploadfile .
  data  : l_filename type string.
  clear : l_filename.
  clear : wa_final_ser_cond.
  refresh : it_final_ser_cond[], it_return.

  l_filename  = p_file.

  data: it_type      type truxs_t_text_data.

  call function 'TEXT_CONVERT_XLS_TO_SAP'
    exporting
      i_field_seperator    = 'X'
      i_line_header        = 'X'
      i_tab_raw_data       = it_type
      i_filename           = p_file
    tables
      i_tab_converted_data = it_final_ser_cond
    exceptions
      conversion_failed    = 1
      others               = 2.
endform.
