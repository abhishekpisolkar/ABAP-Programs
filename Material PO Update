endform.
*&---------------------------------------------------------------------*
*& Form change_po
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form change_po .
  data : po_header                 type bapiekkol,
         po_items                  type table of bapiekpo,
         po_item_acc               type table of bapiekkn,
         po_item_srv_accass_values type table of bapieskl,
         po_item_services          type table of  bapiesll,
         return                    type table of bapireturn,
         lt_return                 type table of bapiret2,
         poitem                    type table of bapimepoitem,
         poitemx                   type table of bapimepoitemx,
         poaccount                 type table of bapimepoaccount,
         poaccountx                type table of bapimepoaccountx,
         posrvaccessvalues         type table of bapiesklc,
         lv_count                  type eskn-zekkn.

  select ebeln from ekko into table @data(it_ekko) for all entries in @it_final_change
                                                   where ebeln = @it_final_change-ebeln.
  if sy-subrc = 0.
    sort it_ekko by ebeln.
  endif.

  loop at it_ekko into data(wa_ekko).
    refresh : po_item_acc, po_items, return, po_item_srv_accass_values,   po_item_services.
    clear : po_header.
    data(lv_po_status) = |Purchase Order| && | { wa_ekko-ebeln } | && | is in progress.|.
    call function 'SAPGUI_PROGRESS_INDICATOR'
      exporting
        text = lv_po_status.
    clear lv_po_status.

    call function 'BAPI_PO_GETDETAIL'
      exporting
        purchaseorder              = wa_ekko-ebeln
        items                      = 'X'
        account_assignment         = 'X'
        services                   = 'X'
      importing
        po_header                  = po_header
      tables
        po_items                   = po_items
        po_item_services           = po_item_services
        po_item_account_assignment = po_item_acc
        po_item_srv_accass_values  = po_item_srv_accass_values
        return                     = return.
    if return is initial.
      refresh : poitem,
                poitemx,
                poaccount,
                poaccountx,
                posrvaccessvalues.
      loop at po_items into data(ls_items).
        poitem = value #( base poitem ( po_item = ls_items-po_item ) ).
        poitemx = value #( base poitemx ( po_item = ls_items-po_item
                                          po_itemx = abap_true ) ).
        loop at po_item_acc into data(ls_item_acc) where po_item = ls_items-po_item.

          loop at it_final_change into data(ls_final_change) where  ebeln = ls_items-po_number and
                                                              ebelp = ls_items-po_item .
            lv_count = lv_count + 1.
            poaccount = value #( base poaccount ( po_item = ls_final_change-ebelp
                                                  serial_no = lv_count
*                                                  distr_perc = '10.0'
                                                  gl_account = |{ ls_final_change-gl_account alpha = in }|
                                                  wbs_element = ls_final_change-wbs_element ) ).
            clear ls_final_change.
          endloop.

          poaccountx = value #( base poaccountx for ls_poaccount in poaccount ( po_item = ls_poaccount-po_item
                                                                serial_no   = ls_poaccount-serial_no
                                                                po_itemx    = abap_true
                                                                serial_nox  = abap_true
*                                                                distr_perc = abap_true
                                                                gl_account  = cond #( when ls_poaccount-gl_account is not initial then abap_true )
                                                                wbs_element = cond #( when ls_poaccount-gl_account is not initial then abap_true ) ) ).
          clear : ls_item_acc, lv_count.
        endloop.
        sort poaccount by po_item serial_no.
        sort poaccountx by po_item serial_no.
        sort poitem by po_item.
        sort poitemx by po_item.
        delete adjacent duplicates from poitem comparing po_item.
        delete adjacent duplicates from poitemx comparing po_item.
        delete adjacent duplicates from poaccount comparing po_item serial_no.
        delete adjacent duplicates from poaccountx comparing po_item serial_no.
        clear : ls_items, lv_count.
      endloop.
      refresh lt_return.
      call function 'BAPI_PO_CHANGE'
        exporting
          purchaseorder     = po_header-po_number
          testrun           = p_test
        tables
          return            = lt_return
          poitem            = poitem
          poitemx           = poitemx
          poaccount         = poaccount
          poaccountx        = poaccountx
          posrvaccessvalues = posrvaccessvalues.
      if line_exists( lt_return[ type = 'E' ] ).
        call function 'BAPI_TRANSACTION_ROLLBACK'.
        it_return = value #( base it_return for wa_return in lt_return where ( type = 'E' )
                    ( ebeln      = po_header-po_number
                      type       = wa_return-type
                      id         = wa_return-id
                      number     = wa_return-number
                      message    = wa_return-message
                      log_no     = wa_return-log_no
                      log_msg_no = wa_return-log_msg_no
                      message_v1 = wa_return-message_v1
                      message_v2 = wa_return-message_v2
                      message_v3 = wa_return-message_v3
                      message_v4 = wa_return-message_v4 ) ).
      else.
        call function 'BAPI_TRANSACTION_COMMIT'
          exporting
            wait = 'X'.

        it_return = value #( base it_return for wa_return in lt_return where ( type <> 'E' and type <> 'W' )
                          ( ebeln      = po_header-po_number
                            type       = wa_return-type
                            id         = wa_return-id
                            number     = wa_return-number
                            message    = wa_return-message
                            log_no     = wa_return-log_no
                            log_msg_no = wa_return-log_msg_no
                            message_v1 = wa_return-message_v1
                            message_v2 = wa_return-message_v2
                            message_v3 = wa_return-message_v3
                            message_v4 = wa_return-message_v4 ) ).
      endif.

    endif.
    clear wa_ekko.
  endloop.
endform.
