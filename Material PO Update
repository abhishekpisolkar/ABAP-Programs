      i_field_seperator    = 'X'
      i_line_header        = 'X'
      i_tab_raw_data       = it_type
      i_filename           = p_file
    tables
      i_tab_converted_data = it_final_text
    exceptions
      conversion_failed    = 1
      others               = 2.
endform.
*&---------------------------------------------------------------------*
*& Form cond_processdata
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form cond_processdata .
  data : purchaseorder like  bapimepoheader-po_number,
         pocond        type table of  bapimepocond,
         pocondx       type table of bapimepocondx,
         return        type table of bapiret2.

  types : begin of ty_header,
            ebeln type ekpo-ebeln,
          end of ty_header.
  data : it_header type table of ty_header.

  move-corresponding it_final_ser_cond[] to it_header[].
  sort it_header by ebeln.
  delete adjacent duplicates from it_header comparing ebeln.

  select a~ebeln, a~unsez, waers from ekko as a
                                 inner join @it_header as b
                                 on a~unsez = b~ebeln
                                 into table @data(it_ekko).
  if sy-subrc = 0.
    sort it_ekko by ebeln.
  endif.

  loop at it_ekko into data(wa_ekko).
    clear purchaseorder.
    refresh : pocond, pocondx, return.
    purchaseorder = wa_ekko-ebeln.
    pocond = value #( for wa_item in it_final_ser_cond where ( ebeln = wa_ekko-unsez )
                      ( itm_number = wa_item-ebelp
                        cond_type  = wa_item-kschl
*                        cond_value = ( wa_item-kbetr / 10 )
                        cond_value = ( wa_item-kbetr / 10 )
                        currency   = wa_ekko-waers
*                        cond_updat = abap_true
                        change_id = 'I'
                        ) ).
    pocondx = value #( for wa_item in it_final_ser_cond where ( ebeln = wa_ekko-unsez )
                      ( itm_number = wa_item-ebelp
                        cond_type  = abap_true
                        cond_value = abap_true
                        currency   = abap_true
*                        cond_updat = abap_true
                        change_id  = abap_true ) ).

    call function 'BAPI_PO_CHANGE'   "#EC CI_USAGE_OK[2438131]
      exporting
        purchaseorder = purchaseorder
        testrun       = p_test
      tables
        return        = return
        pocond        = pocond
        pocondx       = pocondx.

    if line_exists( return[ type = 'E' ] ).
      call function 'BAPI_TRANSACTION_ROLLBACK'.
      it_return = value #( base it_return for wa_return in return where ( type = 'E' )
                  ( ebeln      = wa_ekko-ebeln
                    unsez      = wa_ekko-unsez
                    type       = wa_return-type
                    id         = wa_return-id
                    number     = wa_return-number
                    message    = wa_return-message
                    log_no     = wa_return-log_no
                    log_msg_no = wa_return-log_msg_no
                    message_v1 = wa_return-message_v1
                    message_v2 = wa_return-message_v2
                    message_v3 = wa_return-message_v3
                    message_v4 = wa_return-message_v4 ) ).
    else.
      call function 'BAPI_TRANSACTION_COMMIT'
        exporting
          wait = 'X'.

      it_return = value #( base it_return for wa_return in return where ( type = 'S' )
                        ( ebeln      = wa_ekko-ebeln
                          unsez      = wa_ekko-unsez
                          type       = wa_return-type
                          id         = wa_return-id
                          number     = wa_return-number
                          message    = wa_return-message
                          log_no     = wa_return-log_no
                          log_msg_no = wa_return-log_msg_no
                          message_v1 = wa_return-message_v1
                          message_v2 = wa_return-message_v2
                          message_v3 = wa_return-message_v3
                          message_v4 = wa_return-message_v4 ) ).
    endif.
    clear wa_ekko.
  endloop.
endform.
*&---------------------------------------------------------------------*
*& Form text_processdata
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form text_processdata .
  types : begin of ty_header,
            ebeln    type stxl-tdname,
            ebelp    type ekpo-ebelp,
            unsez    type ekko-unsez,
            tdobject type stxl-tdobject,
            tdid     type stxl-tdid,
          end of ty_header,
          begin of ty_item,
            ebeln    type stxl-tdname,
            ebelp    type ekpo-ebelp,
            unsez    type ekko-unsez,
            tdobject type stxl-tdobject,
            tdid     type stxl-tdid,
          end of ty_item.

  data : it_header type table of ty_header,
         it_item   type table of ty_item.

  data : purchaseorder like  bapimepoheader-po_number,
         potextheader  type table of bapimepotextheader,
         potextitem    type table of bapimepotext,
         return        type table of bapiret2.

  move-corresponding it_final_text to it_header.
  delete adjacent duplicates from it_header comparing ebeln ebelp tdobject tdid.
*  delete it_header where tdobject = 'EKPO'.

  loop at it_final_text into data(wa_final_text) where tdobject = 'EKPO'.
    it_item = value #( base it_item ( ebeln    = wa_final_text-ebeln+0(10)
                                      ebelp    = wa_final_text-ebeln+10(5)
                                      tdobject = wa_final_text-tdobject
                                      tdid     = wa_final_text-tdid ) ).
  endloop.
  sort it_item by ebeln ebelp tdobject tdid.
  delete adjacent duplicates from it_item comparing ebeln ebelp tdobject tdid.
  append lines of it_item to it_header.

  select distinct a~ebeln from ekko as a
                        inner join @it_header as b
                        on a~ebeln = b~ebeln
                        into table @data(it_ekko).
  if sy-subrc = 0.
    sort it_ekko by ebeln.
*    loop at it_header assigning field-symbol(<lfs_header>).
*      read table it_ekko into data(wa_ekko) with key unsez = <lfs_header>-ebeln.
*      if sy-subrc = 0.
*        <lfs_header>-unsez = wa_ekko-ebeln.
*      endif.
*      clear wa_ekko.
*    endloop.
  endif.

  select distinct a~ebeln, a~ebelp from ekpo as a
                                   inner join @it_header as b
                                   on a~ebeln = b~ebeln
                                   and a~ebelp = b~ebelp
                                   into table @data(it_ekpo).
  if sy-subrc = 0.
    sort it_ekpo by ebeln ebelp.
    delete it_header where ebelp is initial and tdobject = 'EKPO'.
  endif.

  loop at it_header into data(wa_header).
    refresh : potextheader,
              potextitem,
              return.
    purchaseorder = wa_header-ebeln.
    case wa_header-tdobject.
      when 'EKKO'.
        read table it_ekko into data(wa_ekko) with key ebeln = wa_header-ebeln.
        if sy-subrc = 0.
          potextheader = value #( base potextheader
                                  for header_text in it_final_text
                                  where ( ebeln = wa_header-ebeln and
                                          tdobject = wa_header-tdobject and
                                          tdid = wa_header-tdid )
                                  ( po_number = wa_header-ebeln
                                    text_id   = header_text-tdid
                                    text_line = header_text-text ) ).
        endif.
      when 'EKPO'.
        read table it_ekpo into data(wa_ekpo) with key ebeln = wa_header-ebeln
                                                       ebelp = wa_header-ebelp.
        if sy-subrc = 0.
          potextitem = value #( base potextitem
                                for item_text in it_final_text
                                where ( ebeln    = |{ wa_header-ebeln }| && |{ wa_header-ebelp }| and
                                        tdobject = wa_header-tdobject and
                                        tdid     = wa_header-tdid )
                                ( po_number = wa_header-ebeln
                                  po_item   = wa_header-ebelp
                                  text_id   = item_text-tdid
                                  text_line = item_text-text ) ).
        endif.
    endcase.

    call function 'BAPI_PO_CHANGE'   "#EC CI_USAGE_OK[2438131]
      exporting
        purchaseorder = purchaseorder
        testrun       = p_test
      tables
        return        = return
        potextheader  = potextheader
        potextitem    = potextitem.
    if line_exists( return[ type = 'E' ] ).
      call function 'BAPI_TRANSACTION_ROLLBACK'.
      it_return = value #( base it_return for wa_return in return where ( type = 'E' )
                  ( ebeln      = wa_header-ebeln
                    ebelp      = wa_header-ebelp
                    unsez      = wa_header-unsez
                    type       = wa_return-type
                    id         = wa_return-id
                    number     = wa_return-number
                    message    = wa_return-message
                    log_no     = wa_return-log_no
                    log_msg_no = wa_return-log_msg_no
                    message_v1 = wa_return-message_v1
                    message_v2 = wa_return-message_v2
                    message_v3 = wa_return-message_v3
                    message_v4 = wa_return-message_v4 ) ).
    else.
      call function 'BAPI_TRANSACTION_COMMIT'
        exporting
          wait = 'X'.

      it_return = value #( base it_return for wa_return in return where ( type <> 'E' and type <> 'W' )
                        ( ebeln      = wa_header-ebeln
                          ebelp      = wa_header-ebelp
                          unsez      = wa_header-unsez
                          type       = wa_return-type
                          id         = wa_return-id
                          number     = wa_return-number
                          message    = wa_return-message
                          log_no     = wa_return-log_no
                          log_msg_no = wa_return-log_msg_no
                          message_v1 = wa_return-message_v1
                          message_v2 = wa_return-message_v2
                          message_v3 = wa_return-message_v3
                          message_v4 = wa_return-message_v4 ) ).
    endif.
    clear wa_header.
  endloop.
endform.
