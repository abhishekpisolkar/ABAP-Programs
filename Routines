*&---------------------------------------------------------------------*
*& Form read_ftp_data_to_int
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form read_ftp_data_to_int .
  data lv_string type string .
  data lv_function type bapifn.
  clear gs_ftp .

  loop at gt_ftp into gs_ftp .
    if gs_ftp-ls_infilet1 is not initial .
*     Split into the respective columns before that define strucure with respective field lengths.

      data(lv_len) = strlen( gs_ftp-ls_infilet1 ) .
      data(lv_offset) = lv_len - 1 .
      data(lv_var) = gs_ftp-ls_infilet1+lv_offset(1) .
      if lv_var eq c_comma .
        clear lv_string .
        lv_string = gs_ftp-ls_infilet1+0(lv_offset) .
      endif.
      if lv_string is initial .
        lv_string = gs_ftp-ls_infilet1 .
      endif.
      split gs_ftp-ls_infilet1 at c_comma into table data(lt_temp).
      describe table lt_temp lines data(lv_count).
      if lv_count lt 19.
        split lv_string at c_comma into gs_mdm_data-request_id
                                        gs_mdm_data-plant
                                        gs_mdm_data-mat_type
                                        gs_mdm_data-hsn_code
                                        gs_mdm_data-val_class
                                        gs_mdm_data-mat_group
                                        gs_mdm_data-batch_manage
                                        gs_mdm_data-manf_part_no
                                        gs_mdm_data-old_mat_code
                                        gs_mdm_data-mat_desc
                                        gs_mdm_data-po_text
                                        gs_mdm_data-ext_mat_group
                                        gs_mdm_data-moving_price
                                        gs_mdm_data-base_unit
                                        gs_mdm_data-abc_indicator
                                        gs_mdm_data-qa_insp_setup
                                        gs_mdm_data-mdm_create_flag
                                        gs_mdm_data-mdm_update_flag
                                        gs_mdm_data-mdm_delete_flag
                                        in character mode .
      else.
        split lv_string at c_comma into gs_mdm_data-request_id
                                        gs_mdm_data-sap_code
                                        gs_mdm_data-plant
                                        gs_mdm_data-mat_type
                                        gs_mdm_data-hsn_code
                                        gs_mdm_data-val_class
                                        gs_mdm_data-mat_group
                                        gs_mdm_data-batch_manage
                                        gs_mdm_data-manf_part_no
                                        gs_mdm_data-old_mat_code
                                        gs_mdm_data-mat_desc
                                        gs_mdm_data-po_text
                                        gs_mdm_data-ext_mat_group
                                        gs_mdm_data-moving_price
                                        gs_mdm_data-base_unit
                                        gs_mdm_data-abc_indicator
                                        gs_mdm_data-qa_insp_setup
                                        gs_mdm_data-mdm_create_flag
                                        gs_mdm_data-mdm_update_flag
                                        gs_mdm_data-mdm_delete_flag
                                        in character mode .
      endif.
      append gs_mdm_data to gt_mdm_data.
      clear : gs_mdm_data, gs_ftp, lv_string.
    endif.
  endloop.

  select matnr meins matkl mtart from mara into table gt_mara for all entries in gt_mdm_data where matnr = gt_mdm_data-sap_code.
  if sy-subrc = 0.
    sort gt_mara by matnr.
    select matnr werks from marc into table gt_marc for all entries in gt_mara where matnr = gt_mara-matnr.
    if sy-subrc = 0.
      sort gt_marc by matnr.
    endif.
  endif.
  loop at gt_mdm_data into gs_mdm_data .
    shift gs_mdm_data-abc_indicator left deleting leading '0'.
    if gs_mdm_data-sap_code is initial.
      lv_function = 'INS'.
    else.
      if gs_mdm_data-mdm_create_flag = '2'.  " Extend
        lv_function = 'INS'.
      elseif gs_mdm_data-mdm_update_flag = '1'. " Update
        lv_function = 'UPD'.
      endif.
    endif.
    if lv_function = 'INS'.
      perform create_extend_material using lv_function.
    elseif lv_function = 'UPD'.
      perform change_material using lv_function.
    endif.
  endloop.
endform.
