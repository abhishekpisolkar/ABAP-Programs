         storagelocationdata     type table of bapie1mard,
         ls_storagelocationdata  type bapie1mard,
         storagelocationdatax    type table of bapie1mardx,
         ls_storagelocationdatax type  bapie1mardx,
         valuationdata           type table of bapie1mbew,
         ls_valuationdata        type bapie1mbew,
         valuationdatax          type table of bapie1mbewx,
         ls_valuationdatax       type bapie1mbewx,
         salesdata               type table of   bapie1mvke,
         salesdatax              type table of  bapie1mvkex,
         ls_salesdatax           type bapie1mvkex,
         materialdescription     type table of bapie1makt,
         taxclassifications      type table of  bapie1mlan,
         materiallongtext        type table of  bapie1mltx,
         unitsofmeasure          type table of  bapie1marm,
         unitsofmeasurex         type table of bapie1marmx,
         return                  type bapiret2.

  data : lv_mtart        type bapimatdoa-matl_type,
         material_number type table of bapimatinr.

  refresh : headdata, clientdata, clientdatax, plantdata, plantdatax,
            storagelocationdata, storagelocationdatax, materiallongtext, material_number.

  clear : ls_clientdata, ls_clientdatax, ls_plantdata, ls_plantdatax,
          ls_storagelocationdata, ls_storagelocationdatax, return, gs_return, lv_mtart.

  lv_mtart = gs_mdm_data-mat_type.
  if p_function = 'INS'.
