         lo_f_label type ref to cl_salv_form_label,
         lo_f_flow  type ref to cl_salv_form_layout_flow.
  try.
      cl_salv_table=>factory(
        importing
          r_salv_table = go_salv_table
        changing
          t_table      = gt_status_table ).
    catch cx_salv_msg into lo_msg ##NO_HANDLER.
  endtry.

  " Get the reference for ALV Display Settings object
  lo_display = go_salv_table->get_display_settings( ).

  " Set striped pattern aka Zebra
  lo_display->set_striped_pattern( if_salv_c_bool_sap=>true ).

* Top of List
