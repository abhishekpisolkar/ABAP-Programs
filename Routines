                                  taxclass_2 = ls_mdm_plant-taxclass_2    " '1'
                                  tax_type_3 = ls_mdm_plant-tax_type_3    " 'JOIG'
                                  taxclass_3 = ls_mdm_plant-taxclass_3    " '1'
                                  tax_type_4 = ls_mdm_plant-tax_type_4    " 'JTC1'
                                  taxclass_4 = ls_mdm_plant-taxclass_4    " '1'
                                  tax_type_5 = ls_mdm_plant-tax_type_5
                                  taxclass_5 = ls_mdm_plant-taxclass_5
                                  tax_type_6 = ls_mdm_plant-tax_type_6
                                  taxclass_6 = ls_mdm_plant-taxclass_6
                                  tax_type_7 = ls_mdm_plant-tax_type_7
                                  taxclass_7 = ls_mdm_plant-taxclass_7
                                  tax_type_8 = ls_mdm_plant-tax_type_8
                                  taxclass_8 = ls_mdm_plant-taxclass_8
                                  tax_type_9 = ls_mdm_plant-tax_type_9
                                  taxclass_9 = ls_mdm_plant-taxclass_9
                                  tax_ind    = ls_mdm_plant-tax_ind  ) ).      " ls_tmkm1-taxim

  " Purchase Long Text
  materiallongtext = value #( ( function = p_function
                                material = ls_material_number-material
                                applobject = ls_mdm_plant-applobject " 'MATERIAL'
                                text_name  = ls_material_number-material
                                text_id    = ls_mdm_plant-text_id    " 'BEST'
                                langu      = ls_mdm_plant-langu      " sy-langu
                                text_line  = gs_mdm_data-po_text ) ).

  " Unit Of Measures
  unitsofmeasure = value #( ( function = p_function
                              material = ls_material_number-material
                              alt_unit = gs_mdm_data-base_unit
                              numerator = ls_mdm_plant-numerator
                              denominatr = ls_mdm_plant-denominatr ) ).

  unitsofmeasurex = value #( for ls_unit in unitsofmeasure ( function = p_function
                                                             material = ls_material_number-material
                                                             alt_unit = gs_mdm_data-base_unit
                                                             numerator = cond #( when ls_unit-numerator is not initial
                                                                                 then abap_true
                                                                                 else abap_false )
                                                             denominatr = cond #( when ls_unit-denominatr is not initial
                                                                                 then abap_true
                                                                                 else abap_false ) ) ).
  call function 'BAPI_MATERIAL_SAVEREPLICA'    "#EC CI_USAGE_OK[2438131]
    exporting
      noappllog            = abap_true
      nochangedoc          = abap_true
      testrun              = abap_false
      inpfldcheck          = 'W'
*     FLAG_CAD_CALL        = ' '
*     NO_ROLLBACK_WORK     = ' '
*     FLAG_ONLINE          = ' '
    importing
      return               = gs_return
    tables
      headdata             = headdata
      clientdata           = clientdata
      clientdatax          = clientdatax
      plantdata            = plantdata
      plantdatax           = plantdatax
      storagelocationdata  = storagelocationdata
      storagelocationdatax = storagelocationdatax
      valuationdata        = valuationdata
      valuationdatax       = valuationdatax
      salesdata            = salesdata
      salesdatax           = salesdatax
      materialdescription  = materialdescription
      taxclassifications   = taxclassifications
      materiallongtext     = materiallongtext
      unitsofmeasure       = unitsofmeasure
      unitsofmeasurex      = unitsofmeasurex.

  if gs_return-type = 'E'.
    call function 'BAPI_TRANSACTION_ROLLBACK'.
    append gs_return to gt_return.
    perform update_opnstatus.
  else.
    data: lt_inspection type standard table of bapi1001004_qmat,
          ls_inspection type bapi1001004_qmat,
          lt_return     type standard table of bapiret2.
    refresh : lt_inspection, lt_return.
    clear: ls_inspection.
    call function 'BAPI_TRANSACTION_COMMIT'
      exporting
        wait = 'X'.
    wait up to 2 seconds .
    clear g_matnr.
*    move gs_return-message_v1 to g_matnr.
    move ls_material_number-material to g_matnr.
    if gs_return-number = '810'.
      gs_return-number = '800'.
      gs_return-message = |Material| && | { g_matnr } | && |created|.
      gs_return-message_v1 = |{ g_matnr alpha = out }|.
    endif.
    append gs_return to gt_return.
    if gs_mdm_data-qa_insp_setup = 'Y'.
*      split ls_mdm_plant-insptype at ',' into data(lv_01) data(lv_89) data(lv_09).
      lt_inspection = value #( ( function                  = '009'
                                 material                  = ls_material_number-material            plant = gs_mdm_data-plant
                                 insptype                  = ls_mdm_plant-insptype                  ind_post_to_insp_stock = ls_mdm_plant-ind_post_to_insp_stock  ind_insptype_mat_active = ls_mdm_plant-ind_insptype_mat_active
                                 preferred_insptype        = 'X'                                    ind_insp_with_tsk_list = ls_mdm_plant-ind_insp_with_tsk_list  ind_auto_assign         = ls_mdm_plant-ind_auto_assign
                                 ind_insp_by_charac        = ls_mdm_plant-ind_insp_by_charac        ind_automatic_ud       = ls_mdm_plant-ind_automatic_ud        ind_skips_allowed         = ls_mdm_plant-ind_skips_allowed
                                 ind_single_units_possible = ls_mdm_plant-ind_single_units_possible qual_score_procedure   = ls_mdm_plant-qual_score_procedure  )

*                               ( function                  = '009'
*                                 material                  = ls_material_number-material            plant = gs_mdm_data-plant
*                                 insptype                  = lv_89                                  ind_post_to_insp_stock = ls_mdm_plant-ind_post_to_insp_stock  ind_insptype_mat_active = ls_mdm_plant-ind_insptype_mat_active
*                                 preferred_insptype        = 'X'                                    ind_insp_with_tsk_list = ls_mdm_plant-ind_insp_with_tsk_list  ind_auto_assign         = ls_mdm_plant-ind_auto_assign
*                                 ind_insp_by_charac        = ls_mdm_plant-ind_insp_by_charac        ind_automatic_ud       = ls_mdm_plant-ind_automatic_ud        ind_skips_allowed         = ls_mdm_plant-ind_skips_allowed
*                                 ind_single_units_possible = ls_mdm_plant-ind_single_units_possible qual_score_procedure   = ls_mdm_plant-qual_score_procedure  )
*
*                               ( function                  = '009'
*                                 material                  = ls_material_number-material            plant = gs_mdm_data-plant
*                                 insptype                  = lv_09                                  ind_post_to_insp_stock = ls_mdm_plant-ind_post_to_insp_stock  ind_insptype_mat_active = ls_mdm_plant-ind_insptype_mat_active
*                                 preferred_insptype        = 'X'                                    ind_insp_with_tsk_list = ls_mdm_plant-ind_insp_with_tsk_list  ind_auto_assign         = ls_mdm_plant-ind_auto_assign
*                                 ind_insp_by_charac        = ls_mdm_plant-ind_insp_by_charac        ind_automatic_ud       = ls_mdm_plant-ind_automatic_ud        ind_skips_allowed         = ls_mdm_plant-ind_skips_allowed
*                                 ind_single_units_possible = ls_mdm_plant-ind_single_units_possible qual_score_procedure   = ls_mdm_plant-qual_score_procedure   )
                                 ).
      delete lt_inspection where insptype is initial.

      call function 'BAPI_MATINSPCTRL_SAVEREPLICA'  "#EC CI_USAGE_OK[2438131]
        tables
          return         = lt_return
          inspectionctrl = lt_inspection.
      if line_exists( lt_return[ type = 'E' ] ).
      else.
        call function 'BAPI_TRANSACTION_COMMIT'
          exporting
            wait = 'X'.
        wait up to 2 seconds .
        append lines of lt_return to gt_return.
      endif.
    endif.
    perform update_opnstatus.
  endif.
endform.
