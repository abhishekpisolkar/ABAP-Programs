                                                 plan_strgp   = cond #( when plant-plan_strgp   is not initial then abap_true else abap_false )
                                                 proc_type    = cond #( when plant-proc_type    is not initial then abap_true else abap_false )
                                                 sm_key       = cond #( when plant-sm_key       is not initial then abap_true else abap_false )
