  lo_h_flow = lo_header->create_flow( row = 1 column = 1 ).
  lo_h_flow->create_text( text =  'WFL - MAINTENANCE REPAIR AND OPERATING SUPPLY').

  lo_h_flow = lo_header->create_flow( row = 2 column = 1 ).
  lo_h_flow->create_text( text = 'Total No of records processed : ').

  lo_h_label = lo_header->create_label( row = 2 column = 2 ).
  lo_h_label->set_text( lv_total_records  ).

  go_salv_table->set_top_of_list( lo_header ).


* Application-Specific Functions
  lo_functions = go_salv_table->get_functions( ).
  lo_functions->set_all( abap_true ).

  lo_columns = go_salv_table->get_columns( ).
  lo_columns->set_optimize( gc_x ).

* Set The Layout
  lo_layout = go_salv_table->get_layout( ).
  ls_key-report = sy-repid.

  lo_layout->set_key( value = ls_key ).

  lo_layout->set_save_restriction(
  value  = if_salv_c_layout=>restrict_none ).

  try.
