*&---------------------------------------------------------------------*
*& Form change_material
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> LV_FUNCTION
*&---------------------------------------------------------------------*
form change_material using p_function type bapifn.
  data : headdata                type table of bapie1matheader,
         clientdata              type table of bapie1mara,
         ls_clientdata           type bapie1mara,
         clientdatax             type table of bapie1marax,
         ls_clientdatax          type bapie1marax,
         plantdata               type table of bapie1marc,
         ls_plantdata            type bapie1marc,
         plantdatax              type table of bapie1marcx,
         ls_plantdatax           type bapie1marcx,
         storagelocationdata     type table of bapie1mard,
         ls_storagelocationdata  type bapie1mard,
         storagelocationdatax    type table of bapie1mardx,
         ls_storagelocationdatax type  bapie1mardx,
         valuationdata           type table of bapie1mbew,
         ls_valuationdata        type bapie1mbew,
         valuationdatax          type table of bapie1mbewx,
         ls_valuationdatax       type bapie1mbewx,
         salesdata               type table of   bapie1mvke,
         salesdatax              type table of  bapie1mvkex,
         ls_salesdatax           type bapie1mvkex,
         materialdescription     type table of bapie1makt,
         taxclassifications      type table of  bapie1mlan,
         materiallongtext        type table of  bapie1mltx,
         unitsofmeasure          type table of  bapie1marm,
         unitsofmeasurex         type table of bapie1marmx,
         return                  type bapiret2.

  data : lv_mtart        type bapimatdoa-matl_type,
         ls_material_number type bapimatinr.

  refresh : headdata, clientdata, clientdatax, plantdata, plantdatax,
            storagelocationdata, storagelocationdatax, materiallongtext.

  clear : ls_clientdata, ls_clientdatax, ls_plantdata, ls_plantdatax, ls_material_number,
          ls_storagelocationdata, ls_storagelocationdatax, return, gs_return, lv_mtart.

  perform op_file_header.

  if p_function = 'UPD'.
    ls_material_number-material = |{ gs_mdm_data-sap_code alpha = in }|.
    data(gs_mara) = value #( gt_mara[ matnr = gs_mdm_data-sap_code ] optional ).
    ls_material_number-material = |{ gs_mdm_data-sap_code alpha = in }|.
    gs_mdm_data-mat_type = gs_mara-mtart.   " Material Type
    if gs_mdm_data-base_unit is initial.
      gs_mdm_data-base_unit = gs_mara-meins.  " Unit of Measure
    endif.
  endif.
  data(ls_views) = value #( gt_views[ mtart = gs_mdm_data-mat_type ] optional ).
  headdata = value #( ( function        = p_function " 'INS'
                        material        = ls_material_number-material
                        ind_sector      = 'M'
                        matl_type       = ls_views-mtart
                        basic_view      = ls_views-v_basic
                        sales_view      = ls_views-v_sales
                        purchase_view   = ls_views-v_purch
                        mrp_view        = ls_views-v_mrp
                        forecast_view   = ls_views-v_forca
                        work_sched_view = ls_views-v_worksc
                        prt_view        = ls_views-v_prt
                        storage_view    = ls_views-v_storag
                        warehouse_view  = ls_views-v_ware
                        quality_view    = ls_views-v_qual
                        account_view    = ls_views-v_acnt
                        cost_view       = ls_views-v_cost    ) ).

  " Client Data
  clientdata = value #( ( function = p_function
                          material = ls_material_number-material
                          old_mat_no = cond #( when gs_mdm_data-old_mat_code is not initial then gs_mdm_data-old_mat_code )
                          matl_group = cond #( when gs_mdm_data-mat_group is not initial then gs_mdm_data-mat_group )
                          base_uom   = cond #( when gs_mdm_data-base_unit is not initial then gs_mdm_data-base_unit )
                          batch_mgmt = cond #( when gs_mdm_data-batch_manage <> 'NA' and
                                                    gs_mdm_data-batch_manage is not initial
                                                    then abap_true else abap_false )
                          manu_mat   = cond #( when gs_mdm_data-manf_part_no  is not initial then gs_mdm_data-manf_part_no )
                          extmatlgrp = cond #( when gs_mdm_data-ext_mat_group is not initial then gs_mdm_data-ext_mat_group )
                          qm_procmnt = cond #( when gs_mdm_data-qa_insp_setup = 'Y' and
                                                    gs_mdm_data-qa_insp_setup is not initial
                                               then abap_true else abap_false ) ) ).

  clientdatax = value #( for client in clientdata ( function = p_function
                          material = ls_material_number-material
                          old_mat_no = cond #( when client-old_mat_no  is not initial then abap_true else abap_false )
                          matl_group = cond #( when client-matl_group  is not initial then abap_true else abap_false )
                          base_uom   = cond #( when client-base_uom    is not initial then abap_true else abap_false )
                          batch_mgmt = cond #( when client-batch_mgmt  is not initial then abap_true else abap_false )
                          manu_mat   = cond #( when client-manu_mat    is not initial then abap_true else abap_false )
                          extmatlgrp = cond #( when client-extmatlgrp  is not initial then abap_true else abap_false )
                          qm_procmnt = cond #( when client-qm_procmnt  is not initial then abap_true else abap_false ) ) ).

*--------------------------------------------------------------------*
  loop at gt_marc into data(gs_marc) where matnr = ls_material_number-material.
    " Plant Master Data
    data(ls_mdm_plant) = value #( gt_mdm_plant[ plant = gs_marc-werks
                                                matl_type = gs_mara-matkl ] optional ).
    " Plant Data
    plantdata = value #( base plantdata
                         ( function               = p_function
                           material               = ls_material_number-material
                           plant                  = gs_marc-werks
                           abc_id                 = cond #( when gs_mdm_data-abc_indicator <> 'NA' then gs_mdm_data-abc_indicator else '' )
                           ctrl_code              = cond #( when gs_mdm_data-hsn_code is not initial then gs_mdm_data-hsn_code else '' )
                           ctrl_key               = cond #( when gs_mdm_data-qa_insp_setup = 'Y' then ls_mdm_plant-ctrl_key )
                           purch_view             = ls_views-v_purch
                           mrp_view               = ls_views-v_mrp
                           forecast_view          = ls_views-v_forca
                           work_sched_view        = ls_views-v_worksc
                           prt_view               = ls_views-v_prt
                           storage_view           = ls_views-v_storag
                           warehouse_view         = ls_views-v_ware
                           quality_view           = ls_views-v_qual
                           account_view           = ls_views-v_acnt
                           cost_view              = ls_views-v_cost ) ).

    plantdatax = value #( base  plantdatax
                          for plant in plantdata ( function               = p_function
                                                   material               = ls_material_number-material
                                                   plant                  = gs_marc-werks
                                                   abc_id     = cond #( when plant-abc_id     is not initial then abap_true else abap_false )
                                                   ctrl_code  = cond #( when plant-ctrl_code  is not initial then abap_true else abap_false )
                                                   ctrl_key   = cond #( when plant-ctrl_key   is not initial then abap_true else abap_false ) ) ).

    " Valuation Data
    ls_valuationdata-function = p_function.
    ls_valuationdatax-function = p_function.

    ls_valuationdata-material = ls_material_number-material.
    ls_valuationdatax-material = ls_material_number-material.

    ls_valuationdata-val_area = gs_marc-werks.
    ls_valuationdatax-val_area = gs_marc-werks.

    if gs_mdm_data-moving_price is not initial.
      ls_valuationdata-moving_pr = gs_mdm_data-moving_price.
      if ls_valuationdata-moving_pr is not initial.
        ls_valuationdatax-moving_pr = abap_true.
      endif.
    endif.

    ls_valuationdata-account_view = ls_views-v_acnt.
    ls_valuationdata-cost_view = ls_views-v_cost.


    append ls_valuationdata  to valuationdata.
    append ls_valuationdatax to valuationdatax.

    " Material Description
    if gs_mdm_data-mat_desc is not initial.
      materialdescription = value #( ( function = p_function
                                       material = ls_material_number-material
                                       langu    = sy-langu
                                       matl_desc = gs_mdm_data-mat_desc ) ).
    endif.

    " Unit Of Measures
    if gs_mdm_data-base_unit is not initial.
      unitsofmeasure = value #( ( function = p_function
                                  material = ls_material_number-material
                                  alt_unit = gs_mdm_data-base_unit
                                   ) ).

      unitsofmeasurex = value #( for ls_unit in unitsofmeasure ( function = p_function
                                                                 material = ls_material_number-material
                                                                 alt_unit = gs_mdm_data-base_unit
                                                                  ) ).
    endif.
    clear : gs_marc, ls_mdm_plant, ls_valuationdata, ls_valuationdatax.
  endloop.
  call function 'BAPI_MATERIAL_SAVEREPLICA'    "#EC CI_USAGE_OK[2438131]
    exporting
      noappllog           = abap_true
      nochangedoc         = abap_true
      testrun             = abap_false
      inpfldcheck         = 'W'
*     FLAG_CAD_CALL       = ' '
*     NO_ROLLBACK_WORK    = ' '
*     FLAG_ONLINE         = ' '
    importing
      return              = gs_return
    tables
      headdata            = headdata
      clientdata          = clientdata
      clientdatax         = clientdatax
      plantdata           = plantdata
      plantdatax          = plantdatax
*     storagelocationdata = storagelocationdata
*     storagelocationdatax = storagelocationdatax
      valuationdata       = valuationdata
      valuationdatax      = valuationdatax
*     salesdata           = salesdata
*     salesdatax          = salesdatax
      materialdescription = materialdescription
*     taxclassifications  = taxclassifications
*     materiallongtext    = materiallongtext
      unitsofmeasure      = unitsofmeasure
      unitsofmeasurex     = unitsofmeasurex.

  if gs_return-type = 'E'.
    call function 'BAPI_TRANSACTION_ROLLBACK'.
    append gs_return to gt_return.
    perform update_opnstatus.
  else.
    data: lt_inspection type standard table of bapi1001004_qmat,
          ls_inspection type bapi1001004_qmat,
          lt_return     type standard table of bapiret2.
    refresh : lt_inspection, lt_return.
    clear: ls_inspection.
    call function 'BAPI_TRANSACTION_COMMIT'
      exporting
        wait = 'X'.
    wait up to 2 seconds .
    clear g_matnr.
*    move gs_return-message_v1 to g_matnr.
    move ls_material_number-material to g_matnr.
    if gs_return-number = '810'.
      if p_function = 'INS'.
        if gs_mdm_data-mdm_create_flag = '1'.
          gs_return-number = '800'.
          gs_return-message = |Material| && | { g_matnr } | && |created|.
          gs_return-message_v1 = |{ g_matnr alpha = out }|.
        elseif gs_mdm_data-mdm_create_flag = '2'.
          gs_return-number = '800'.
          gs_return-message = |Material| && | { g_matnr } | && |extended|.
          gs_return-message_v1 = |{ g_matnr alpha = out }|.
        endif.
      elseif p_function = 'UPD'.
        gs_return-number = '801'.
        gs_return-message = |Material| && | { g_matnr } | && |changed|.
        gs_return-message_v1 = |{ g_matnr alpha = out }|.
      endif.
    endif.
    append gs_return to gt_return.
    if gs_mdm_data-qa_insp_setup = 'Y'.
      split ls_mdm_plant-insptype at ',' into data(lv_01) data(lv_89) data(lv_09).
      lt_inspection = value #( ( function                  = '009'
                                 material                  = ls_material_number-material            plant = gs_mdm_data-plant
                                 insptype                  = lv_01                                  ind_post_to_insp_stock = ls_mdm_plant-ind_post_to_insp_stock  ind_insptype_mat_active = ls_mdm_plant-ind_insptype_mat_active
                                 preferred_insptype        = 'X'                                    ind_insp_with_tsk_list = ls_mdm_plant-ind_insp_with_tsk_list  ind_auto_assign         = ls_mdm_plant-ind_auto_assign
                                 ind_insp_by_charac        = ls_mdm_plant-ind_insp_by_charac        ind_automatic_ud       = ls_mdm_plant-ind_automatic_ud        ind_skips_allowed         = ls_mdm_plant-ind_skips_allowed
                                 ind_single_units_possible = ls_mdm_plant-ind_single_units_possible qual_score_procedure   = ls_mdm_plant-qual_score_procedure  )

                               ( function                  = '009'
                                 material                  = ls_material_number-material            plant = gs_mdm_data-plant
                                 insptype                  = lv_89                                  ind_post_to_insp_stock = ls_mdm_plant-ind_post_to_insp_stock  ind_insptype_mat_active = ls_mdm_plant-ind_insptype_mat_active
                                 preferred_insptype        = 'X'                                    ind_insp_with_tsk_list = ls_mdm_plant-ind_insp_with_tsk_list  ind_auto_assign         = ls_mdm_plant-ind_auto_assign
                                 ind_insp_by_charac        = ls_mdm_plant-ind_insp_by_charac        ind_automatic_ud       = ls_mdm_plant-ind_automatic_ud        ind_skips_allowed         = ls_mdm_plant-ind_skips_allowed
                                 ind_single_units_possible = ls_mdm_plant-ind_single_units_possible qual_score_procedure   = ls_mdm_plant-qual_score_procedure  )

                               ( function                  = '009'
                                 material                  = ls_material_number-material            plant = gs_mdm_data-plant
                                 insptype                  = lv_09                                  ind_post_to_insp_stock = ls_mdm_plant-ind_post_to_insp_stock  ind_insptype_mat_active = ls_mdm_plant-ind_insptype_mat_active
                                 preferred_insptype        = 'X'                                    ind_insp_with_tsk_list = ls_mdm_plant-ind_insp_with_tsk_list  ind_auto_assign         = ls_mdm_plant-ind_auto_assign
                                 ind_insp_by_charac        = ls_mdm_plant-ind_insp_by_charac        ind_automatic_ud       = ls_mdm_plant-ind_automatic_ud        ind_skips_allowed         = ls_mdm_plant-ind_skips_allowed
                                 ind_single_units_possible = ls_mdm_plant-ind_single_units_possible qual_score_procedure   = ls_mdm_plant-qual_score_procedure   )
                                 ).
      delete lt_inspection where insptype is initial.

      call function 'BAPI_MATINSPCTRL_SAVEREPLICA'  "#EC CI_USAGE_OK[2438131]
        tables
          return         = lt_return
          inspectionctrl = lt_inspection.
      if line_exists( lt_return[ type = 'E' ] ).
      else.
        call function 'BAPI_TRANSACTION_COMMIT'
          exporting
            wait = 'X'.
        wait up to 2 seconds .
        append lines of lt_return to gt_return.
      endif.
    endif.
    perform update_opnstatus.
  endif.

  if p_file is initial.
    perform ftp_connect .
    perform post_optoftp.
    perform ftp_disconnect .
  endif.
endform.
