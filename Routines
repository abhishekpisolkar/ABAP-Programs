    call function 'BAPI_MATERIAL_GETINTNUMBER'  "#EC CI_USAGE_OK[2438131]
      exporting
        material_type   = lv_mtart
        industry_sector = 'M'
      tables
        material_number = material_number.

    data(ls_material_number) = material_number[ 1 ].
