*&---------------------------------------------------------------------*
*& Form post_optoftp
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form post_optoftp .
  data : lt_text(4096)    type c occurs 0,
         lt_text1(4096)   type c occurs 0,
         lv_filename(255) type c,
         lv_path(255)     type c,
         lv_cmd(255)      type c,
         lv_result        type table of text with header line,
         lv_sep           type char01.

  lv_sep = '|' .
  call function 'SAP_CONVERT_TO_CSV_FORMAT'
    exporting
      i_field_seperator    = lv_sep
    tables
      i_tab_sap_data       = gt_output_file
    changing
      i_tab_converted_data = lt_text
    exceptions
      conversion_failed    = 1
      others               = 2.
  if sy-subrc <> 0.
    case sy-subrc.
      when 1 .
        message 'Text Conversion of Excel Data Failed' type 'E' .
      when others.
        message 'Error Occured While Converting the data into text Format' type 'E'.
    endcase.
  endif.

  loop at  lt_text into data(ls_text)  .
    replace all occurrences of ';' in ls_text with lv_sep .
    append ls_text  to lt_text1 .
    clear : ls_text .
  endloop.


*  lv_path  = cond #( when sy-sysid = 'WED' then '/Welspun_MDM/DEV/WEL/MATERIAL/OUTPUT/'
*                     when sy-sysid = 'WEQ' then '/Welspun_MDM/QA/WEL/MATERIAL/OUTPUT/'
*                     when sy-sysid = 'WEP' then '/Welspun_MDM/PROD/WEL/MATERIAL/OUTPUT/' ).
  lv_path = cond #( when sy-sysid = 'WED' then '/Welspun_MDM/DEV/WEL_HANA/MATERIAL_REQUEST/OUTPUT/'
                      when sy-sysid = 'WEQ' then '/Welspun_MDM/QA/WEL_HANA/MATERIAL_REQUEST/OUTPUT/'
                      when sy-sysid = 'WEP' then '/Welspun_MDM/PROD/WEL_HANA/MATERIAL_REQUEST/OUTPUT/' ).

  concatenate 'cd' lv_path into lv_cmd separated by space .
  call function 'FTP_COMMAND'
    exporting
      handle        = gv_handle
      command       = lv_cmd  "'PUT'
    tables
      data          = lv_result
    exceptions
      tcpip_error   = 1
      command_error = 2
      data_error    = 3
      others        = 4.
  if sy-subrc <> 0.
    case sy-subrc .
      when 1.
        message 'TCP_IP ERROR' type 'E'.
      when 2.
        message 'COMMAND  ERROR' type 'E'.
      when 3.
        message 'DATA ERROR' type 'E'.
      when others.
        message 'ERROR OCCURED WHILE CONNECTING TO FTP SERVER' type 'E'.
    endcase.
  else.

    data : ts1 type string .
    get time stamp field data(ts) .

    ts1 = ts .

    concatenate 'Output_' gs_mdm_data-request_id '_' ts1  '.CSV'  into lv_filename  .
*    concatenate 'Output_' gs_mdm_data-old_mat_code '_' ts1  '.CSV'  into lv_filename  .
    call function 'FTP_R3_TO_SERVER'
      exporting
        handle         = gv_handle
        fname          = lv_filename
        character_mode = 'X'
      tables
        text           = lt_text1
      exceptions
        tcpip_error    = 1
        command_error  = 2
        data_error     = 3
        others         = 4.

  endif .
endform.
