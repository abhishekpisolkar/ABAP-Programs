  modify zmm_mdm_status from gs_status_table .
  append gs_status_table to gt_status_table.
  lv_total_records = lines( gt_status_table ).
  condense lv_total_records.
  get time stamp field data(timestamp) .


  gs_output_file-request_id            = gs_mdm_data-request_id .
  gs_output_file-mdm_create_flag       = gs_mdm_data-mdm_create_flag .
