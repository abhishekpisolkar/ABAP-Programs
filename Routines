  gs_output_file-delim2  =  lv_delmi .
  gs_output_file-delim3  =  lv_delmi .
  gs_output_file-delim4  =  lv_delmi .
  gs_output_file-delim5  =  lv_delmi .
  gs_output_file-delim6  =  lv_delmi .
  gs_output_file-delim7  =  lv_delmi .
  gs_output_file-delim8  =  lv_delmi .
  gs_output_file-delim9  =  lv_delmi .
  gs_output_file-delim10 =  lv_delmi .
  gs_output_file-delim11 =  lv_delmi .
  gs_output_file-delim12 =  lv_delmi .
