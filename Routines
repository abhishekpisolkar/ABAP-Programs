                                                 mrp_ctrler = cond #( when plant-mrp_ctrler is not initial then abap_true else abap_false )
                                                 profit_ctr = cond #( when plant-profit_ctr is not initial then abap_true else abap_false )
                                                 availcheck = cond #( when plant-availcheck is not initial then abap_true else abap_false )
                                                 loadinggrp = cond #( when plant-loadinggrp is not initial then abap_true else abap_false )
                                                 ctrl_code  = cond #( when plant-ctrl_code  is not initial then abap_true else abap_false )
                                                 ctrl_key   = cond #( when plant-ctrl_key   is not initial then abap_true else abap_false )
