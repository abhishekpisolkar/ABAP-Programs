*&---------------------------------------------------------------------*
*& Form read_ftp_file
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form read_ftp_file .
  clear gt_data.
  gv_cmd = 'dir' .
  call function 'FTP_COMMAND'
    exporting
      handle        = gv_handle
      command       = gv_cmd
    tables
      data          = gt_data
    exceptions
      tcpip_error   = 1
      command_error = 2
      data_error    = 3
      others        = 4.
  if sy-subrc <> 0.
    message 'FTP_COMMAND: dir is not successfully' type 'E'.
  endif.

  call function 'SAPGUI_PROGRESS_INDICATOR'
    exporting
      text = 'Reading Files in the Directory'.


  if gt_data[] is not initial .
    loop at gt_data into gs_data .
      condense gs_data-line .
      split gs_data-line at space into table data(lt_dir1).
      delete lt_dir1 where table_line ns '.CSV'.
      append lines of lt_dir1 to gt_file.
    endloop.
  endif.
endform.
*&---------------------------------------------------------------------*
*& Form read_data_from_files
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form read_data_from_files .
  data : lv_string type string .
  if gt_file[] is not initial .
    loop at gt_file into gs_file .
      clear : gt_mdmlog, gs_mdm_data .
      refresh : gt_mdmlog , gt_mdm_data.
      if  gs_file-pathname(2) = 'CR' or gs_file-pathname(2) = 'Cr' or gs_file-pathname(2) = 'cr' or
          gs_file-pathname(2) = 'UP' or gs_file-pathname(2) = 'Up' or gs_file-pathname(2) = 'up' or
          gs_file-pathname(2) = 'EX' or gs_file-pathname(2) = 'Ex' or gs_file-pathname(2) = 'ex'.
        g_filenm  = gs_file-pathname."pathname .
        call function 'FTP_SERVER_TO_R3'
          exporting
            handle         = gv_handle
            fname          = g_filenm
            character_mode = 'X'
          tables
            text           = gt_mdmlog
          exceptions
            tcpip_error    = 1
            command_error  = 2
            data_error     = 3
            others         = 4.
        if sy-subrc <> 0.
* Implement suitable error handling here
          data(lv_msg) = | && 'FTP Read File Error' && { g_filenm }|.
          message lv_msg type 'S'.
          continue . "Process next file b'coz of error
        endif.

        if gt_mdmlog is not initial .
          delete gt_mdmlog where field is initial .
          delete gt_mdmlog index 1 .
          loop at gt_mdmlog into gs_mdmlog .
            concatenate gs_ftp-ls_infilet1 gs_mdmlog-field into gs_ftp-ls_infilet1 .
            replace all occurrences of '|' in gs_ftp-ls_infilet1 with c_comma .
            condense gs_ftp-ls_infilet1 .
            append gs_ftp to gt_ftp .
            clear : gs_ftp, gs_mdmlog .
          endloop.
        endif.
      endif.
    endloop.
  endif .

  if gt_ftp is initial.
    message 'No files at FTP' type 'E'.
    leave list-processing.
    exit.
  endif.

  clear gs_ftp .
  perform ftp_disconnect.
  perform read_ftp_data_to_int.     " FTP Data to Internal Table
  perform ftp_connect .


  loop at gt_file into gs_file .

    data : file_bs  type string,
           file_ext type string.

    get time stamp field data(ts) .
*    lv_f1  = cond #( when sy-sysid = 'WEP' then '/Welspun_MDM/PROD/WEL/MATERIAL/INPUT/'
*                     when sy-sysid = 'WEQ' then '/Welspun_MDM/QA/WEL/MATERIAL/INPUT/'
*                     when sy-sysid = 'WED' then '/Welspun_MDM/DEV/WEL/MATERIAL/INPUT/'  ).
*
*    lv_f2  = cond #( when sy-sysid = 'WEP' then '/Welspun_MDM/PROD/WEL/ARCHIVE/MATERIAL/Archive/'
*                     when sy-sysid = 'WEQ' then '/Welspun_MDM/QA/WEL/ARCHIVE/MATERIAL/Archive/'
*                     when sy-sysid = 'WED' then '/Welspun_MDM/DEV/WEL/ARCHIVE/MATERIAL/Archive/' ).
    lv_f1  = cond #( when sy-sysid = 'WED' then '/Welspun_MDM/DEV/WEL_HANA/MATERIAL_REQUEST/INPUT/'
                      when sy-sysid = 'WEQ' then '/Welspun_MDM/QA/WEL_HANA/MATERIAL_REQUEST/INPUT/'
                      when sy-sysid = 'WEP' then '/Welspun_MDM/PROD/WEL_HANA/MATERIAL_REQUEST/INPUT/' ).

    lv_f2  = cond #( when sy-sysid = 'WEP' then '/Welspun_MDM/PROD/WEL_HANA/Archive/MATERIAL_REQUEST/'
                     when sy-sysid = 'WEQ' then '/Welspun_MDM/QA/WEL_HANA/Archive/MATERIAL_REQUEST/'
                     when sy-sysid = 'WED' then '/Welspun_MDM/DEV/WEL_HANA/Archive/MATERIAL_REQUEST/' ).

    condense : lv_f1,lv_f2.
    lv_file1 = lv_f1 && gs_file-pathname .
    lv_file2 = lv_f2 && gs_file-pathname .

    condense : lv_file1 , lv_file2.
    split gs_file-pathname at  c_dot
          into file_bs file_ext
          in character mode  .

    file_bs = file_bs && '_' && ts && '.csv' .

    clear : lv_file2 .

    lv_file2 = lv_f2 && file_bs .


    concatenate 'rename' lv_file1 lv_file2 into gv_cmd separated by space .

    call function 'FTP_COMMAND'
      exporting
        handle        = gv_handle
        command       = gv_cmd
      tables
        data          = gt_result
      exceptions
        tcpip_error   = 1
        command_error = 2
        data_error    = 3
        others        = 4.
    if sy-subrc <> 0.
      lv_msg = |FTP_COMMAND { gv_cmd } is not sucessfull|.
      message lv_msg type 'E'.
    endif.
*    lv_f1  = cond #( when sy-sysid = 'WEP' then '/Welspun_MDM/PROD/WEL/MATERIAL/INPUT/'
*                     when sy-sysid = 'WED' then '/Welspun_MDM/DEV/WEL/MATERIAL/INPUT/'
*                     when sy-sysid = 'WEQ' then '/Welspun_MDM/QA/WEL/MATERIAL/INPUT/' ).
    lv_f1  = cond #( when sy-sysid = 'WED' then '/Welspun_MDM/DEV/WEL_HANA/MATERIAL_REQUEST/INPUT/'
                     when sy-sysid = 'WEQ' then '/Welspun_MDM/QA/WEL_HANA/MATERIAL_REQUEST/INPUT/'
                     when sy-sysid = 'WEP' then '/Welspun_MDM/QA/WEL_HANA/MATERIAL_REQUEST/INPUT/' ).

    concatenate 'cd' lv_f1 into gv_cmd separated by space .
    call function 'FTP_COMMAND'
      exporting
        handle        = gv_handle
        command       = gv_cmd
      tables
        data          = gt_result
      exceptions
        tcpip_error   = 1
        command_error = 2
        data_error    = 3
        others        = 4.
    if sy-subrc <> 0.
      lv_msg = |FTP_COMMAND { gv_cmd } is not sucessfull|.
      message lv_msg type 'E'.
    endif.
    wait up to 1 seconds .
    clear : gs_ftp , lv_f1, lv_f2, lv_file1, lv_file2, gs_file.
  endloop.

  perform ftp_disconnect .
  perform log_display.
endform.
