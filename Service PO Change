*&---------------------------------------------------------------------*
*& Form POSTPO
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form postpo .
  refresh it_ret.
*  WAIT UP TO 10 SECONDS.
*  call function 'BAPI_PO_CREATE1'  "#EC CI_USAGE_OK[3404390]
*    exporting
*      poheader          = wa_header
*      poheaderx         = wa_headerx
*      testrun           = p_test
*      no_price_from_po  = 'X'
*    importing
*      exppurchaseorder  = po
*    tables
*      return            = it_ret[]
*      poitem            = it_item[]
*      poitemx           = it_itemx[]
*      poaccount         = it_acc[]
*      poaccountx        = it_accx[]
**     poschedule        = it_sch[]     -- Abhishek.P(12.02.2025)
**     poschedulex       = it_schx[]    -- Abhishek.P(12.02.2025)
*      poservices        = it_ser[]
*      posrvaccessvalues = it_sacc[]
**     pocomponentsx     = it_comx[]     -- Abhishek.P(12.02.2025)
**     pocomponents      = it_com[]      -- Abhishek.P(12.02.2025)
*      pocond            = it_cond[]
*      pocondx           = it_condx[].
**      polimits          = it_lim[]      -- Abhishek.P(12.02.2025)
**      popartner         = it_partner[]. -- Abhishek.P(12.02.2025)
**      poshipping        = shipping
**      poshippingx       = shippingx.

  call function 'BAPI_PO_CHANGE'
    exporting
      purchaseorder     = wa_header-po_number
      testrun           = p_test
      no_price_from_po  = 'X'
    tables
      return            = it_ret
      poitem            = it_item
      poitemx           = it_itemx
      poaccount         = it_acc
      poaccountx        = it_accx
      poservices        = it_ser
      posrvaccessvalues = it_sacc.

  read table it_ret into wa_ret with key type = 'E'.
  if sy-subrc = 0.

    loop at it_ret into wa_ret where type = 'E'.
      wa_final-ebeln = wa_tmp-ebeln.
      wa_final-typ   = 'Error'.
      wa_final-msg   = wa_ret-message.
      append wa_final to it_final.
      clear wa_final.
    endloop.

  else.
    call function 'BAPI_TRANSACTION_COMMIT'
      exporting
        wait = 'X'.
    wait up to 1 seconds.

    loop at it_ret into wa_ret where type ne 'E' and type ne 'W'.
      wa_final-ebeln = wa_tmp-ebeln.
      wa_final-newpo = po.
      wa_final-typ   = wa_ret-type.
      wa_final-msg   = wa_ret-message.
      append wa_final to it_final.
      clear wa_final.
    endloop.
  endif.

endform.
