  call function 'CONVERSION_EXIT_ALPHA_INPUT'
    exporting
      input  = wa_tmp-lifnr
    importing
      output = wa_tmp-lifnr.

*  wa_header-vper_start  = wa_tmp-st_date.
*  wa_header-vper_end    = wa_tmp-en_date.
*  wa_headerx-vper_start = 'X'.
*  wa_headerx-vper_end   = 'X'.

*  if wa_tmp-date is not initial.
*    concatenate wa_tmp-date+6(4) wa_tmp-date+3(2) wa_tmp-date+0(4) into date.
*    condense date.
*    shift date left deleting leading space.
*  endif.
*
  if wa_tmp-dpdate is not initial.
    concatenate wa_tmp-dpdate+6(4) wa_tmp-dpdate+3(2) wa_tmp-dpdate+0(4) into dpdate.
    condense dpdate.
    shift dpdate left deleting leading space.
  endif.
*
*  if wa_tmp-svdate is not initial.
