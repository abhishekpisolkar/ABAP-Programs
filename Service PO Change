form processdata .

  refresh : it_tmp[],it_final[],it_acc[],it_item[],it_sch[],it_accx[],it_itemx[],it_schx[],it_ser[],it_sacc[].
  clear:wa_file,wa_tmp,wa_final,wa_ser,wa_sacc,serno.
  it_tmp[] = it_file[].
  it_main  = it_file[].

  sort it_tmp  by ebeln ebelp.
  sort it_main by ebeln ebelp.
  delete adjacent duplicates from it_tmp  comparing ebeln.
  delete adjacent duplicates from it_main comparing ebeln ebelp.

  perform fetchunit.
  packno = pno.

  data : lv_packno  type packno value 1,
         lv_subpack type sub_packno,
         lv_ebeln   type ekpo-ebeln,
         lv_ebelp   type ekpo-ebelp,
         lv_count   type srv_line_no.

  if it_tmp[] is not initial.

    break del_abap13.
    select DISTINCT a~ebeln, a~ebelp from ekpo as a inner join @it_tmp as b on a~ebeln = b~ebeln and a~ebelp = b~ebelp into table @data(lt_ekpo).
    if sy-subrc = 0.
      sort lt_ekpo by ebeln ebelp.
    endif.
    loop at it_tmp into wa_tmp.
      data(lv_po_status) = |Purchase Order| && | { wa_tmp-ebeln } | && | is in progress.|.
      call function 'SAPGUI_PROGRESS_INDICATOR'
        exporting
          text = lv_po_status.
      clear lv_po_status.
      read table lt_ekpo into data(ls_ekpo) with key ebeln = wa_tmp-ebeln ebelp = wa_tmp-ebelp.
      if sy-subrc <> 0.
        on change of wa_tmp-ebeln.
          if lv_packno is initial.
            lv_packno = 1.
          endif.
        endon.
        " Header
        perform fillheader.

        loop at it_main into wa_main where ebeln = wa_tmp-ebeln.
          if wa_main-ebelp <> lv_ebelp.  " ls_file-ebeln <> lv_ebeln and
            lv_packno = lv_subpack + lv_packno." + 1.
            lv_subpack = lv_packno + 1.
            lv_ebelp = wa_main-ebelp.
          else.
            lv_ebelp = wa_main-ebelp.
          endif.
          perform fillitem using lv_subpack lv_packno ."CHANGING  wa_item-pckg_no.
        endloop.
*--------------------------------------------------------------------*
        break del_abap13.

        refresh : it_sacc. "it_acc,
        clear : wa_acc, wa_sacc.
        sort it_service by pckg_no line_no subpckg_no.
        delete adjacent duplicates from it_service comparing pckg_no line_no subpckg_no.
        loop at it_service into wa_service.
          lv_count = lv_count + 1.
          wa_ser-pckg_no    = wa_service-pckg_no.
          wa_ser-line_no    = lv_count. " wa_ser-line_no + 1.
          wa_ser-ext_line   = wa_service-ext_line.
          wa_ser-outl_ind   = wa_service-outl_ind.
          wa_ser-subpckg_no = wa_service-subpckg_no.
          append wa_ser to it_ser.

          loop at it_file into wa_file where ebeln = wa_main-ebeln
                                       and   ebelp = wa_service-ebelp.
            lv_count = lv_count + 1.
            wa_ser-pckg_no    = wa_service-subpckg_no.
            clear wa_ser-subpckg_no.
            wa_ser-line_no    = lv_count.
            wa_ser-ext_line   = wa_file-seritem.
            wa_ser-outl_ind   = abap_false.
            call function 'CONVERSION_EXIT_MATNE_INPUT'
              exporting
                input  = wa_file-srvpos
              importing
                output = wa_ser-service.
            wa_ser-quantity   = wa_file-smenge.
            wa_ser-base_uom   = wa_file-suom.
            wa_ser-gr_price   = wa_file-gpriceunit.

            append wa_ser to it_ser.
            clear wa_file.

            wa_sacc-pckg_no = wa_service-subpckg_no.
            wa_sacc-line_no = wa_service-line_no.
*          wa_sacc-serno_line = wa_ser-ext_line.
            wa_sacc-serial_no =  wa_sacc-serial_no + 1.
*          wa_sacc-
*          wa_sacc-percentage = '100'.
            append wa_sacc to it_sacc.
          endloop.
          clear : wa_service, wa_ser.
        endloop.
        " Fill Account Assignment
        refresh : it_sacc.
        clear wa_sacc.
        data(lt_acc) = it_acc[].
        sort lt_acc by po_item.
        delete adjacent duplicates from lt_acc comparing po_item.
        loop at it_service into wa_service.
          loop at it_ser into wa_ser where pckg_no = wa_service-subpckg_no. " outl_ind is INITIAL.
            loop at lt_acc into wa_acc where po_item = wa_service-ebelp.
              wa_sacc-pckg_no = wa_ser-pckg_no.
              wa_sacc-line_no = wa_ser-line_no.
*            wa_sacc-serial_no = wa_acc-serial_no.
              wa_sacc-serial_no = wa_sacc-serial_no + 1.
              append wa_sacc to it_sacc.
            endloop.
            clear wa_ser.
          endloop.
          clear wa_sacc.
          clear wa_service.
        endloop.
*--------------------------------------------------------------------*
        clear : lv_packno, lv_subpack,wa_main.
        break del_abap13.
        perform postpo.

        clear : wa_file,wa_tmp,wa_header,wa_headerx,wa_acc,wa_accx,wa_item,wa_itemx,wa_ser,wa_com,wa_comx,wa_cond,wa_condx,wa_lim,
                packno,subpack,wa_sacc,wa_sch,wa_schx,gs_count,wa_wyt3,wa_partner, lv_ebeln, lv_ebelp, lv_count.
        refresh : it_itemx[],it_item[],it_acc[],it_accx[],it_ser[],it_com[],it_comx[],it_cond[],it_condx[],it_lim[],
                  it_sacc[],it_sch[],it_schx[],it_partner[],it_wyt3[], it_service[].
      endif.
    endloop.

  endif.


